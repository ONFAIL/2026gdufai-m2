# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交。
# 新增变量时同步更新本文件与 README。

# ---- 服务 ----
PORT=3000
NODE_ENV=development
TZ=Asia/Shanghai
# Compose 镜像名称；首次 GHCR 发布后可使用 ghcr.io/tarnishedtaffy/2026gdufai:sha-<完整提交 SHA>
IMAGE_NAME=gdufai:local

# ---- 存储 ----
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads

# ---- 鉴权（单用户演示）----
# 本期固定单用户；入站 userId 必须与之一致
DEMO_USER_ID=u_001
APP_AUTH_TOKEN=change-me
# 前端构建期变量，必须与 DEMO_USER_ID 相同（默认 u_001）
VITE_DEMO_USER_ID=u_001

# ---- AI 服务（OpenAI 兼容协议统一适配，见 ADR-0002）----
# LLM 文本/追问抽取（必填：使用真实 AI 时填写）
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# OCR 小票多模态识别（可选，未填时默认复用 LLM_API_BASE_URL / LLM_API_KEY / LLM_MODEL）
OCR_API_BASE_URL=
OCR_API_KEY=
OCR_MODEL=
# ASR 语音转写（可选，地址与密钥未填时默认复用 LLM；模型默认 whisper-1）
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
# 外部 AI 请求超时时间（毫秒，正整数，默认 30000）
AI_TIMEOUT_MS=30000

# ---- 通知（M4，可选）----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
QQ_BOT_WEBHOOK=
